- content_for(:has_back_to_btn, true)
= render 'jsonld'

.contain.contain--yield
	.flex.mb-6{class: 'md:justify-between md:items-center md:flex-row flex-col'}
		%h1.text-3xl.font-semibold{class: 'md:mb-0 mb-2'}= @category.name
		-	if @books.any?
			.flex.gap-2
				.select-field.btn.btn-clear{class: 'h-8 rounded-md px-2', data: {controller: 'select-field'}}
					%select{data: {action: 'change->select-field#updateUrlParams', param: 'popularity'}}
						%optgroup{label: "Popularity"}
							%option{value: "most-popular", selected: params[:popularity] == 'most-popular'} Most popular
							%option{value: "least-popular", selected: params[:popularity] == 'least-popular'} Least popular
					.rounded-md.flex.gap-2.text-sm.items-center
						%i.ph.ph-trend-up
						%span{'data-select-field-target': 'label'}
						%i.ph.ph-caret-down
				.select-field.btn.btn-clear{class: 'h-8 rounded-md px-2', data: {controller: 'select-field'}}
					%select{data: {action: 'change->select-field#updateUrlParams', param: 'sort'}}
						%optgroup{label: "Published at"}
							%option{value: "recent", selected: params[:sort] == 'recent'} Newest first
							%option{value: "oldest", selected: params[:sort] == 'oldest'} Oldest first
					.rounded-md.flex.gap-2.text-sm.items-center
						%i.ph.ph-arrows-down-up
						%span{'data-select-field-target': 'label'}
						%i.ph.ph-caret-down
		
	- if !@books.any?
		=	render 'partials/empty_state', title: "Nothing here", description: "We haven't added any #{@category.name} books yet. Check back again soon."
	- else
		.grid.gap-4.gap-y-6#books_grid{class: 'md:grid-cols-5 grid-cols-2'}
			= render partial: 'partials/book_card_block', collection: @books.each, as: :book, locals: { small: true, hide_category: true }
		= turbo_frame_tag "pagination" do
			- if @pagy.next
				= turbo_frame_tag "pagination", src: category_path(@category.slug, page: @pagy.next, format: :turbo_stream), loading: :lazy do
					.py-12.flex-center
						.loading-spinner.border-2.opacity-50.w-6.h-6