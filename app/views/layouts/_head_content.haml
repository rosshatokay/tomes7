= yield(:meta_tags)
= display_meta_tags site: "Tomes"
= action_cable_meta_tag

%meta{name: 'viewport', content: "width=device-width,initial-scale=1"}

= csrf_meta_tags
= csp_meta_tag

%link(rel="icon" href="/favicon.ico")
%link(rel="icon" href="/favicon.svg" type="image/svg+xml")
%link(rel="apple-touch-icon" href="/apple-touch-icon.png")

= yield(:jsonld)

	
-# - if yield(:no_robots) == 'true'
-# 	%meta{name: 'robots', content: 'noindex, nofollow'}
-# - elsif !admin_signed_in?
-# 	%meta{name: 'robots', content: 'index, follow'}

-# Fonts
%link(rel="preconnect" href="https://fonts.googleapis.com")/
%link(rel="preconnect" href="https://fonts.gstatic.com" crossorigin)/
%link(rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Instrument+Sans:ital,wght@0,400;0,500;0,700;1,400&display=swap")/
%link(rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@phosphor-icons/web@2.1.1/src/regular/style.css")/
%link(rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@phosphor-icons/web@2.1.1/src/fill/style.css")/
%link(rel="stylesheet" href="https://cdn.jsdelivr.net/npm/choices.js/public/assets/styles/choices.min.css")/

%link{rel: 'manifest', href: '/manifest.json'}

%meta{name: "turbo-prefetch", content: "false"}
%meta{name: "turbo-refresh-scroll", content: "reset"}

- if Rails.env.development?
	%meta{name: "turbo-cache-control", content: "no-cache"}

= stylesheet_link_tag 'application', media: 'all'

= yield(:include_stylesheets)

%script(src="https://www.googletagmanager.com/gtag/js?id=G-FGZLZ061LB")
:javascript
	window.dataLayer = window.dataLayer || [];
	function gtag(){dataLayer.push(arguments);}
	gtag('js', new Date());

	gtag('config', 'G-FGZLZ061LB');