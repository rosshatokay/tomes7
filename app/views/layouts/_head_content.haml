= yield(:meta_tags)
= display_meta_tags site: "Tomes"
= action_cable_meta_tag
-# = display_meta_tags ok: { title: :title, description: :description }

%meta{name: 'viewport', content: "width=device-width,initial-scale=1"}

= csrf_meta_tags
= csp_meta_tag

%link(rel="icon" href="/favicon.ico")
%link(rel="icon" href="/favicon.svg" type="image/svg+xml")
%link(rel="apple-touch-icon" href="/apple-touch-icon.png")

= yield(:jsonld)

-# - if @seo_tags.present?
	%link{rel: 'canonical', href: canonical_url}
	%meta{name: 'description', content: @seo_tags[:description]}
	%meta{property: 'og:title', content: @full_head_title.presence || formatted_head_title}
	%meta{property: 'og:description', content: @seo_tags[:description]}
	%meta{property: 'og:type', content: @seo_tags[:type]}
	%meta{property: 'og:url', content: canonical_url}
	%meta{property: 'og:image', content: @seo_tags[:image].presence || banner_url}
	%meta{property: 'og:site_name', content: 'Gleam News'}

	%meta{name: 'twitter:card', content: 'summary_large_image'}
	%meta{name: 'twitter:title', content: @full_head_title.presence || formatted_head_title}
	%meta{name: 'twitter:description', content: @seo_tags[:description]}
	%meta{name: 'twitter:image', content: @seo_tags[:image].presence || banner_url}
	%meta{name: 'twitter:url', content: canonical_url}
	
