.contain.py-6.pb-16.flex.flex-col.gap-16
	%section 
		%h2.font-medium.text-xl.mb-5 Browse categories
		.grid{class: 'md:grid-cols-4 grid-cols-2 md:gap-4 gap-2'}
			-	Category.all.take(8).each do |c|
				.btn.relative.w-full.flex.bg-surface.justify-start.p-6.rounded-xl.overflow-hidden{class: 'h-[150px] hover:bg-black/10 dark:hover:bg-white/15 transition md:items-end items-start' }
					=	link_to '', category_path(c.slug), class: 'absolute inset-0 z-2'
					.relative.z-1
						%span.text-2xl= category_emoji(c.slug)
						%h3.font-medium.text-lg.mt-2{class: 'whitespace-break-spaces leading-[1.2]'}= c.name

	%section.varousel-container
		.flex.justify-between.items-center.mb-2
			=	link_to trending_books_explore_index_path, class: 'flex gap-2 items-center group' do
				%h2.font-medium.text-xl Trending books
				%i.ph.ph-caret-right.text-base{class: 'opacity-50 group-hover:opacity-100'}
			.flex.gap-2
				%button.varousel-prev{type: 'button', class: 'btn btn-icon btn-surface w-8'}
					%i.ph.ph-caret-left.text-secondary
				%button.varousel-next{type: 'button', class: 'btn btn-icon btn-surface w-8'}
					%i.ph.ph-caret-right.text-secondary
		%section
			.relative
				.flex.gap-4.varousel.overflow-x-auto.p-2.pb-6{class: '-mx-2'}
					=	render partial: 'partials/book_card_block', collection: @trending_books, as: :book, locals: { wrapper_class: 'md:w-[calc((100%/5)_-_14px)] md:min-w-[calc((100%/5)_-_14px)] min-w-[calc((100%/2)_-_14px)] w-[calc((100%/2)_-_14px)] flex', small: true }

	%section.varousel-container
		.flex.justify-between.items-center.mb-2
			=	link_to trending_authors_explore_index_path, class: 'flex gap-2 items-center group' do
				%h2.font-medium.text-xl Trending authors
				%i.ph.ph-caret-right.text-base{class: 'opacity-50 group-hover:opacity-100'}
			.flex.gap-2
				%button.varousel-prev{type: 'button', class: 'btn btn-icon btn-surface w-8'}
					%i.ph.ph-caret-left.text-secondary
				%button.varousel-next{type: 'button', class: 'btn btn-icon btn-surface w-8'}
					%i.ph.ph-caret-right.text-secondary
		%section
			.relative
				.flex.gap-5.varousel.overflow-x-auto.p-2.pb-6{class: '-mx-2'}
					-	@trending_authors.each do |author|
						.flex.flex-col.gap-2.items-center.relative.group
							=	link_to '', author_path(author.slug), class: 'absolute inset-0'
							%div.aspect-square.rounded-full.overflow-hidden.bg-surface{class: 'w-[130px] transition ring-2 ring-transparent group-hover:ring-black dark:group-hover:ring-white'}
								= ik_image_tag(author.avatar, transformation: [{width: '130', height: '130'}], class: 'w-full aspect-square object-cover')
							%div.text-center
								.font-medium{class: 'text-[15px]'}= author.full_name


	-	@categories.each do |c|
		- category_books = c.books.to_a.delete_if { |b| @selected_ids.include?(b.id) }
		%section.varousel-container
			.flex.justify-between.items-center.mb-2
				=	link_to category_path(c.slug), class: 'flex gap-2 items-center group' do
					%h2.font-medium.text-xl Popular in #{c.name}
					%i.ph.ph-caret-right.text-base{class: 'opacity-50 group-hover:opacity-100'}
				.flex.gap-2
					%button.varousel-prev{type: 'button', class: 'btn btn-icon btn-surface w-8'}
						%i.ph.ph-caret-left.text-secondary
					%button.varousel-next{type: 'button', class: 'btn btn-icon btn-surface w-8'}
						%i.ph.ph-caret-right.text-secondary
				
			.relative
				.flex.gap-4.varousel.overflow-x-auto.p-2.pb-6{class: '-mx-2'}
					=	render partial: 'partials/book_card_block', collection: category_books.take(7), as: :book, locals: { wrapper_class: 'md:w-[calc((100%/5)_-_14px)] md:min-w-[calc((100%/5)_-_14px)] min-w-[calc((100%/2)_-_14px)] w-[calc((100%/2)_-_14px)] flex', small: true }
				