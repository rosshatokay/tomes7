.contain.contain--yield
	= render 'header'

	%h2.text-xl.font-medium.mb-4 Saved books
	- if !@saved_books.any?
		=	render 'partials/empty_state', title: "Nothing here", description: @user == current_user ? "You haven't saved any books yet." : "#{@user.username} hasn't saved any books yet."
	- else
		.grid.gap-4.gap-y-6#books_grid{class: 'md:grid-cols-5 grid-cols-2'}
			= render partial: 'partials/book_card_block', collection: @saved_books, as: :book, locals: { small: true, hide_category: true }
			= turbo_frame_tag "pagination" do
				- if @pagy.next
					= turbo_frame_tag "pagination", src: saved_profile_path(@user.username, page: @pagy.next, format: :turbo_stream), loading: :lazy do
						.py-12.flex-center
							.loading-spinner.border-2.opacity-50.w-6.h-6
				