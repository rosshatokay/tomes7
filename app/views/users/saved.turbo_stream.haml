= turbo_stream.append "books_grid" do
	- @saved_books.each do |book|
		= render partial: 'partials/book_card_block', locals: { book: book, small: true, hide_category: true }

= turbo_stream.replace "pagination" do
	- if @pagy.next
		= turbo_frame_tag "pagination", src: saved_profile_path(@user.username, page: @pagy.next, format: :turbo_stream), loading: :lazy do
			.py-6.pb-10.flex-center
				.loading-spinner
