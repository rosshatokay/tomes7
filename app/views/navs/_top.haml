- links = [{label: 'Home', path: root_path}, {label: 'Explore', path: explore_index_path}]

- if user_signed_in?
	.fixed.top-0.left-0.w-full.h-16.z-10{class: 'bg-white/95 dark:bg-[#181819e0] backdrop-blur-lg'}
		.contain.grid.h-full.items-center{class: 'grid-cols-[1fr_1.2fr_1fr]'}
			.flex.items-center.gap-8
				=	link_to root_path, class: 'logo h-7' do
					=	show_svg 'logo-icon.svg'
				.flex.gap-6
					-	links.each_with_index do |link, i|
						- is_current = request.path == link[:path]
						= link_to link[:label], link[:path], class: "text-[15px] transition #{is_current ? 'font-medium' : 'text-secondary hover:text-[var(--color-on-background)]'}"
			- unless yield(:hide_nav_search) == 'true'
				.relative{data: {controller: 'app-search-bar'}}
					%i.ph.ph-magnifying-glass{class: 'absolute top-1/2 -translate-y-1/2 left-4 text-xl text-secondary'}
					%input{type: 'text', id: 'search', autocomplete: 'off', placeholder: 'Search books, authors, categories...', class: 'input-field h-10 pl-11 text-[15px] rounded-full'}
					.loading-spinner{class: 'w-5 h-5 !border-2 absolute top-1/2 -translate-1/2 opacity-50 right-4 !hidden'}
			- else
				%div
			.flex.justify-end.gap-2.items-center
				-	if authenticated?
					%div{'data-tippy-content': 'Notifications', data: {controller: "notifications-menu"}}
					-# %div{data: {controller: 'profile-menu'}}
					=	render 'partials/user_dropdown'
					-# .action-menu
						%toggler asd
						.hidden
							.context
								asd

					- if current_user.admin?
						=	link_to 'Dashboard', admins_root_path, class: 'btn btn-surface h-9'
				- else
					=	link_to 'Sign in', new_session_path, class: 'btn btn-surface h-9'
					=	link_to 'Join for free', new_registration_path, class: 'btn btn-primary h-9'
- else
	=	render 'static/top'

.h-16