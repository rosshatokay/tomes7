%div{class: 'md:pt-[200px] pt-25 contain mx-auto'}
	.flex.flex-col.mb-16{class: 'md:items-center md:text-center'}
		%h2{class: 'md:text-[60px] text-4xl font-semibold leading-none max-w-[800px] md:mb-6 mb-4'} From beloved masterpieces to hidden gems
		%div{class: 'max-w-[480px] md:text-xl text-lg text-secondary'} Explore the works that shaped literature. Available instantly, anywhere.

	.grid.gap-4{class: 'md:grid-cols-5 grid-cols-2'}
		-	@featured_books.take(5).each do |book|
			=	render 'partials/book_card_block', book: book, small: true

	%div{class: 'pt-[200px]'}
		.flex.flex-col.mb-16{class: 'md:items-center md:text-center'}
			%h2{class: 'md:text-[64px] text-4xl font-semibold leading-none max-w-[800px] md:mb-6 mb-4'} Built especially for book lovers
			.text-2xl{class: 'max-w-[480px] md:text-xl text-lg text-secondary'} Tomes makes makes reading effortless and enjoyable. Packed with useful feature.
		-	@features.each_with_index do |feature, i|
			%div{class: "md:grid grid-cols-2 md:gap-0 #{i == 0 ? 'md:pt-[100px]' : 'md:pt-[100px] pt-20'} flex flex-col gap-6"}
				.flex-center{class: "#{i.odd? ? "md:order-1 order-2" : "md:order-0 order-2"}"}
					%div{class: 'md:max-w-[500px] flex flex-col md:gap-6 gap-4'}
						.border.border-outline.uppercase.w-fit.font-medium.rounded-full{class: 'md:p-2 md:px-4 p-1.5 px-3 md:text-sm text-[11px]'}= feature[:badge_label]
						%h3{class: 'md:text-[54px] text-2xl md:leading-none leading-[1.2] font-semibold'}= feature[:heading]
						%p.text-secondary{class: 'md:text-xl text-lg leading-[1.3]'}= feature[:description]
						=	link_to 'Join for free', new_registration_path, class: 'btn btn-secondary md:h-12 h-11 md:text-base px-6 mt-4'
				%div{class: "#{!i.odd? ? "md:pl-16 md:order-1 order-1" : "md:pr-16 md:order-0 order-1"}"}
					%div{class: 'w-full h-[400px] md:h-[600px] bg-surface rounded-xl', style: "background: url(#{asset_path("feature_#{i + 1}.png")}) center / cover;"}

	%div{class: 'md:py-[200px] py-25'}
		.flex.justify-center.items-center{class: 'md:flex-row flex-col md:gap-16 gap-12'}
			- @stats.each_with_index do |stat, i|
				.flex-center.flex-col.text-center{class: 'max-w-[280px]'}
					%i.ph{class: "#{stat[:icon]} md:text-4xl text-3xl mb-6"}
					%h3.font-semibold{class: "md:text-5xl text-4xl mb-3"}= stat[:heading]
					%p.text-lg.text-secondary= stat[:description]
				- if i < @stats.length - 1
					%div{class: 'md:w-px md:h-20 w-20 h-px bg-black/10 dark:bg-white/10'}

