.landing-scene.opacity-0
	%div{class: 'md:pt-[100px] pt-16 md:h-[1200px] h-[800px] overflow-hidden relative'}
		.absolute.pointer-events-none.w-full{class: 'h-[600px] z-2 bg-linear-to-t from-[var(--color-background)] to-transparent bottom-0 left-0'}
		%div#splash-text-container{class: 'md:w-full mb-12 relative z-2 contain max-w-[900px] w-full mx-auto md:text-center flex flex-col items-center'}
			%h1#splash-h1{class: 'md:text-[74px] text-[42px] w-full font-semibold  leading-[1] mb-4'}= title "Read the greatest books of all time. For free."
			%p.text-secondary#splash-p{class: 'md:text-xl text-base max-w-[420px] md:mb-8 mb-6'} Access timeless classics for free. In one beautiful reading app.
			%div#splash-search-bar{class: 'max-w-[480px] w-full relative z-3', data: {controller: 'app-search-bar'}}
				%i.ph.ph-magnifying-glass.text-xl.text-secondary{class: 'absolute top-1/2 -translate-y-1/2 left-5'}
				%input{type: 'text', id: 'search', autocomplete: 'off', placeholder: 'Search books, authors', class: 'input-field h-12 pl-12 pr-12 text-base rounded-full'}
				.loading-spinner{class: 'w-5 h-5 !border-2 absolute top-1/2 -translate-1/2 opacity-50 right-4 !hidden'}

		.relative.pointer-events-none
			%div{class: 'md:w-[calc(100%+((100vw/7)))] w-[calc(100%+((100vw)))] flex md:gap-6 gap-2 absolute left-1/2 -translate-x-1/2'}
				%div.splash-g-4{class: 'flex flex-col gap-6'}
					%img{src: 'https://ik.imagekit.io/tomes/books/covers/v0fjqqnzg0mi10g6bwqmws1i3uj1?tr=w-1000:w-3840,c-at_max', class: 'md:rounded-lg rounded-md'}
					%img{src: 'https://ik.imagekit.io/tomes/books/covers/vddj1o01qmjwlrsty8rqqf55ew3o?tr=w-1000:w-3840,c-at_max', class: 'md:rounded-lg rounded-md'}
				%div.splash-g-3{class: 'flex flex-col gap-6 md:mt-[48px] mt-2'}
					%img{src: 'https://ik.imagekit.io/tomes/books/covers/y66id8u2gi9mko65bihfu5pwph8i?tr=w-1000:w-3840,c-at_max', class: 'md:rounded-lg rounded-md'}
					%img{src: 'https://ik.imagekit.io/tomes/books/covers/j2ezfw8rbknolfzq1nsye6q7o3o6?tr=w-1000:w-3840,c-at_max', class: 'md:rounded-lg rounded-md'}
				%div.splash-g-2{class: 'flex flex-col gap-6 md:mt-[96px] mt-4'}
					%img{src: 'https://ik.imagekit.io/tomes/books/covers/4i4b6nsr6jkhpywiibwml3hugbcn?tr=w-1000:w-3840,c-at_max', class: 'md:rounded-lg rounded-md'}
					%img{src: 'https://ik.imagekit.io/tomes/books/covers/qy6ic8l4wufmwaj37mf9k1y76u24?tr=w-1000:w-3840,c-at_max', class: 'md:rounded-lg rounded-md'}
				%div.splash-g-1{class: 'flex flex-col gap-6 md:mt-[144px] mt-6'}
					%img{src: 'https://ik.imagekit.io/tomes/books/covers/wqojc98crukiw0mjryb0r34t2edz?tr=w-1000:w-3840,c-at_max', class: 'md:rounded-lg rounded-md'}
					%img{src: 'https://ik.imagekit.io/tomes/books/covers/wv482vi7jsexty0abh95ijqt9090?tr=w-1000:w-3840,c-at_max', class: 'md:rounded-lg rounded-md'}
				%div.splash-g-2{class: 'flex flex-col gap-6 md:mt-[96px] mt-4'}
