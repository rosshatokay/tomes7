					%img{src: 'https://ik.imagekit.io/tomes/books/covers/hanbexxqrd8n4a6uo2yf6im7nfqr?tr=w-1000:w-3840,c-at_max', class: 'md:rounded-lg rounded-md'}
				%div.splash-g-3{class: 'flex flex-col gap-6 md:mt-[48px] mt-2'}
