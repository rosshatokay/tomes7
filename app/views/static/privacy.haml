- content_for(:hide_nav_search, true)
	
%article.contain.contain--extra-small.static.pt-8
	%h1.text-4xl.font-semibold= title "Privacy Policy"
	%p.text-secondary.mt-3 Last updated at #{Time.parse("11-04-2026").strftime('%d %B, %Y')}
	.border-b.border-outline.my-8
	.text-justify
		=	render_markdown(@markdown_file)

