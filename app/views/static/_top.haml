- content_for(:hide_nav, true)

.w-full.fixed.top-0.left-0.flex-center#static-nav{class: 'md:h-16 h-14 bg-white/95 dark:bg-[#181819e0] backdrop-blur-lg z-10', 'data-turbo-permanent': true}
	.contain.h-8.w-full{class: 'md:grid md:grid-cols-3 flex justify-between'}
		.flex.items-center
			=	link_to root_path, class: 'logo logo-full h-6 w-fit' do
				=	show_svg 'logo.svg'
		%div.gap-6{class: 'md:flex items-center justify-center hidden'}
			=	link_to 'Explore', explore_index_path, class: 'font-medium text-m text-secondary hover:text-on-background'
			-# =	link_to 'Request a book', book_request_path, class: 'font-medium text-m text-secondary hover:text-on-background'
			=	link_to 'About', about_path, class: 'font-medium text-m text-secondary hover:text-on-background'
		.justify-end.flex.gap-2
			- if authenticated?
				%div{'data-tippy-content': 'Notifications', data: {controller: "notifications-menu"}}
				=	render 'partials/user_dropdown'
			- else
				=	link_to 'Sign in', new_session_path, class: 'btn btn-surface md:h-9 h-8 md:!text-m !text-sm md:flex hidden'
				=	link_to 'Join for free', new_registration_path, class: 'btn btn-primary md:h-9 h-8 md:!text-m !text-sm'