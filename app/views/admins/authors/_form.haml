- is_edit = @author.persisted?
- avatar_url = nil
- if is_edit && @author.avatar.attached?
	- avatar_url = @author.avatar.service.url(@author.avatar.blob.key)

= form_for @author, url: is_edit ? admins_author_path(@author.hashid) : admins_authors_path, method: is_edit ? :patch : :post, html: {class: 'flex flex-col gap-4', data: {turbo: false}} do |f|
	.flex.items-center.gap-4{data: {controller: 'image-upload-preview'}}
		.w-16.aspect-square.rounded-full.bg-surface.flex-center{'data-image-upload-preview-target': 'cover', style: avatar_url.present? ? "background: url(#{avatar_url}) center / cover;" : nil}
			-	if !avatar_url
				%i.ph.ph-user.text-2xl.text-secondary
		.btn.btn-border.h-9.rounded-xl.relative
			=	f.file_field :avatar, class: 'absolute inset-0 opacity-0', 'data-image-upload-preview-target': 'field'
			%i.ph.ph-upload
			%span Upload
	.flex.flex-col.gap-2
		= f.label :full_name, class: 'label-field'
		= f.text_field :full_name, class: 'input-field h-10', placeholder: "Author's first name"
	.flex.flex-col.gap-2
		= f.label :bio, class: 'label-field'
		= f.text_area :bio, class: 'input-field p-4 max-h-[200px]', placeholder: "Author's biography"
	.flex.flex-col.gap-2
		= f.label :wiki_url, class: 'label-field'
		= f.text_field :wiki_url, class: 'input-field h-10', placeholder: "Author's wikipedia page URL"
	
	%button{type: 'submit', class: 'btn btn-primary w-full h-10 mt-4 rounded-xl'}= is_edit ? 'Save' : 'Create'
