.contain--extra-small
	.dashboard-heading.flex.justify-between.items-center
		%div
			%h1 Welcome back
			%p= Time.current.strftime('%A %d, %Y')
	
	%div{class: 'grid md:grid-cols-3 grid-cols-2 gap-3'}
		.border.border-outline.rounded-xl.p-4
			%i.ph.ph-user.block.mb-4.text-xl.text-secondary.opacity-70
			.font-medium.text-lg.leading-none.mb-2= User.count
			%p.text-secondary.leading-none.text-sm Users
		.border.border-outline.rounded-xl.p-4
			%i.ph.ph-book.block.mb-4.text-xl.text-secondary.opacity-70
			.font-medium.text-lg.leading-none.mb-2= Book.count
			%p.text-secondary.leading-none.text-sm Books
		.border.border-outline.rounded-xl.p-4
			%i.ph.ph-user.block.mb-4.text-xl.text-secondary.opacity-70
			.font-medium.text-lg.leading-none.mb-2= User.where("created_at > ?", 1.days.ago).count
			%p.text-secondary.leading-none.text-sm Sign ups last 24h
	.mt-6
		= render	Forms::SelectComponent.new(option_groups: @date_range_option_groups, icon: nil, url_param: :date_range)
		-# .border.border-outline.w-fit.text-sm.p-2.rounded-full.px-3.font-medium Last 7 days
		.border.border-outline.p-4.rounded-xl.mt-4
			.flex.items-center.justify-between
				.font-medium Activity
				%i.ph.ph-caret-right.text-secondary
			.my-4.mb-6
				.font-medium.text-xl= @users_scope.count
				.flex.items-center.gap-2
					.w-2.min-w-2.aspect-square.rounded-full.bg-indigo-500 
					.text-secondary.text-sm Registrations
			= column_chart @users_scope.group_by_day(:created_at).count
		.border.border-outline.rounded-xl.mt-4
			.p-4.pb-0
				.flex.items-center.justify-between.mb-4
					.font-medium Most read
					%i.ph.ph-caret-right.text-secondary
			.flex.flex-col.p-1.pt-0
				- @most_read_books.each do |book|
					.flex.items-center.justify-between.p-3.py-2{class: 'hover:bg-surface transition relative rounded-md'}
						=	link_to '', edit_admins_book_path(book.hashid), class: 'absolute inset-0'
						.flex.items-center.gap-4
							- if book.cover.attached?
								=	ik_image_tag(book.cover, class: 'aspect-book w-10 min-w-10 rounded-md object-fit')
							%div
								.font-medium= book.title
								.text-secondary.text-m= book.author_names
						.pr-4.font-medium= book.readers_count	