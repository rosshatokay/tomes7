.contain.contain--extra-small
	.dashboard-heading
		%h1.text-3xl Feedback
		%p.text-secondary ##{@feedback.hashid} | submitted #{time_ago_in_words(@feedback.created_at)} by #{@feedback.user.username}

	.p-4.border.border-outline.rounded-xl
		.flex.items-center.gap-2.mb-4
			%img{src: @feedback.user.get_avatar, class: 'w-8 aspect-square rounded-full object-cover'}
			%p.font-medium= @feedback.user.username
		%p= simple_format @feedback.body