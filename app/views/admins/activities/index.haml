.contain.contain--extra-small
	.dashboard-heading
		%h1 Activities
	
	- @activities.each do |act|
		-	bg_icon = activity_bg_icon(action: act.action)
		.flex.items-center.gap-4.py-4.justify-between{class: 'border-b border-black/5 dark:border-white/10'}
			.flex.items-center.gap-4
				.relative
					%img{src: act.user.get_avatar_url, class: 'min-w-9 w-9 aspect-square rounded-full object-fit'}
					.absolute.rounded-full.aspect-square.w-5.flex-center{class: "-right-2 -bottom-2 border-2 border-[var(--color-background)] #{bg_icon[:bg]}"}
						%i.text-xs.ph-fill{class: bg_icon[:icon]}
				%div 
					%p
						%span.font-medium=	act.user.username
						%span= act.action.humanize.downcase
						%span.font-medium= act.subject.title || act.subject.username
			%p.text-secondary #{time_ago_in_words(act.created_at)} ago
	.mt-6
	=raw	@pagy.series_nav