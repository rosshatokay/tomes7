-# locals: (review:)

.flex.flex-col.gap-4.p-4.bg-surface.rounded-lg.mb-4
	.w-full
		.flex.justify-between.items-center.w-full.mb-1
			.flex.items-start.gap-4
				%img{src: review.user.get_avatar(size: 40), class: 'w-10 aspect-square rounded-full'}
				%div 
					%h4
						=	link_to profile_path(review.user.username), class: 'hover:text-primary transition' do
							%span.text-m.font-medium= review.user.username
						%span.text-secondary.text-sm added a review
					= render 'partials/rating_stars', rating: review.score
			
			%p.text-secondary.text-sm
				- if review.created_at.localtime > Time.current.yesterday 
					%span #{time_ago_in_words(review.created_at)} ago
				- else
					%span= review.created_at.strftime('%B %d, %Y')
		- if review.body.present?
			.mt-4
				%p.text-m= simple_format(review.body)