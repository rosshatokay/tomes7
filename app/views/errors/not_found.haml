%html
	%head
		= render 'layouts/head_content'
		= stylesheet_link_tag 'tailwind', "data-turbo-track": "reload"
		= javascript_include_tag "application", type: "module", "data-turbo-track": "reload"
		= javascript_include_tag 'theme'
	%body
		:css
			.logo svg path {
				fill: var(--color-on-background)
			}
		.absolute.top-6.left-6
			.logo.h-5.opacity-50
				=	show_svg 'logo.svg'
		.w-full.h-screen.flex-center.flex-col
			.bg-surface.text-secondary.p-2.py-1.rounded-lg.text-sm.mb-4 404
			%h1.text-5xl.font-semibold.mb-4 Page not found
			%p.text-secondary The page you are looking for doesn't exist or has been moved
			= link_to 'Back to home', root_path, class: 'btn btn-primary h-9 mt-6'