%html
	%head
		= render 'layouts/head_content'
		= stylesheet_link_tag 'tailwind', "data-turbo-track": "reload"
		= javascript_include_tag "application", type: "module", "data-turbo-track": "reload"
		= javascript_include_tag 'theme'
	%body
		:css
			.logo svg path {
				fill: var(--color-on-background)
			}
		.absolute.top-6.left-6
			.logo.h-5.opacity-50
				=	show_svg 'logo.svg'
		.w-full.h-screen.flex-center.flex-col
			.bg-surface.text-secondary.p-2.py-1.rounded-lg.text-sm.mb-4 500
			%h1.text-5xl.font-semibold.mb-4 Something went wrong
			%p.text-secondary.text-center 
				%span Looks like something went awry on our end. We are looking into it.
				%br/
				%span Try refreshing the page.
			%button{class: 'btn btn-primary h-9 mt-6', onclick: 'location.reload()'} Refresh page