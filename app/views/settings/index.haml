- content_for(:has_back_to_btn, true)
- avatar_url = current_user.avatar.attached? ? current_user.avatar.service.url(current_user.avatar.blob.key) : nil

.contain.contain--extra-small.contain--yield
	-# %h1.text-3xl.font-semibold.mb-6 Settings
	= render 'settings/header'
	
	= form_with model: current_user, url: profile_settings_path, method: :patch, html: {class: 'flex flex-col gap-5 max-w-[640px]'}, data: {controller: 'form-with-loading-submit-btn', turbo: false} do |f|
		.flex.flex-col.gap-2{data: {controller: 'image-upload-preview'}}
			= f.label :avatar, 'Profile picture', class: 'label-field'
			.flex.items-center.gap-4
				.btn.btn-icon.btn-clear.w-16.p-1
					.w-14.aspect-square.rounded-full.relative{'data-image-upload-preview-target': 'cover', style: "background: url(#{current_user.get_avatar_url(size: 100)}) center / cover;"}
						=	f.file_field :avatar, class: 'absolute cursor-pointer inset-0 opacity-0',accept: 'image/png, image/jpg, image/jpeg, image/avif, image/webp', 'data-image-upload-preview-target': 'field'
				= f.label :avatar, class: 'btn btn-border h-9' do
					%i.ph.ph-upload-simple
					%span Upload an image
			%p.text-sm.text-secondary Must be a PNG, JPEG, WEBP, or AVIF file smaller than 5MB (recommended ratio 1:1).
		.flex.flex-col.gap-2
			= f.label :username, class: 'label-field'
			= f.text_field :username, class: 'input-field p-3 pointer-events-none opacity-50', placeholder: "Enter a username", disabled: true
			%p.text-sm.text-secondary Currently not available to change.
		.flex.flex-col.gap-2
			= f.label :email_address, class: 'label-field'
			= f.text_field :email_address, class: 'input-field p-3 pointer-events-none opacity-50', placeholder: "Enter your email address", disabled: true
			%p.text-sm.text-secondary Currently not available to change.
		.flex.flex-col.gap-2
			= f.label :bio, class: 'label-field'
			= f.text_area :bio, class: 'input-field min-h-[150px] p-3', placeholder: "Enter a short bio about yourself"
		.flex.flex-col.gap-2
			%label.label-field Appearance
			.select-field{class: 'w-[200px]', data: {controller: 'select-field'}}
				%select#select-theme{name: '', class: 'w-fit p-2'}
					%option{value: 'system'} System
					%option{value: 'light'} Light
					%option{value: 'dark'} Dark
				.btn.btn-surface.h-11.gap-3.rounded-xl.justify-between.w-full
					%span.text-m{'data-select-field-target': 'label'}
					%i.ph.ph-caret-down

		.cta.mt-4
			%button.btn.btn-secondary.h-11.text-m Save changes