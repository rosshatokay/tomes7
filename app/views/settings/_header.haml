- settings_links = [['Profile', settings_path], ['Preferences', preferences_settings_path], ['Privacy', '']]

%h1.text-3xl.font-semibold Settings

.flex.gap-2.my-6
	- settings_links.each do |link|
		=	link_to link[0], link[1], class: "text-m btn h-9 #{link[1] == request.path ? 'btn-primary' : 'btn-border opacity-60 hover:opacity-100'}"