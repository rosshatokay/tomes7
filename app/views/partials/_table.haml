%div{ class: 'overflow-x-auto' }
	%div{ class: 'align-middle min-w-full' }
		%table{ class: 'min-w-full relative' }
			%thead{class: 'border-b border-outline'}
				%tr
					-	headings.each_with_index do |h, i|
						%th{class: "p-3 font-medium text-left #{i == 0 ? 'pl-0' : nil}"}= h
			%tbody
				-# - @.each_with_index do |b, index|
				-# 	%tr{class: "cursor-pointer transition hover:bg-black/10 dark:hover:bg-white/10 #{index == @briefs.count - 1 ? 'relative' : 'border-b border-outline relative'}", onclick: "location.href = '#{edit_admins_brief_path(b.hashid)}'"}
				= yield