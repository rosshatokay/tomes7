%footer.flex.flex-col.gap-4.pb-6
	-	if !user_signed_in?
		.w-full.bg-surface.rounded-2xl.flex-center.flex-col{class: 'md:text-center md:p-16 p-10'}
			%h2{class: 'md:text-5xl text-3xl font-semibold max-w-[500px]'} Your next book awaits for you to read
			%p.mt-4.text-lg.text-secondary{class: 'max-w-[400px]'} Tomes is free to join and open to everyone. Sign up today and start reading ebooks.
			=	link_to 'Join now for free', new_registration_path, class: 'mt-6 btn btn-primary md:h-12 h-11 md:text-base text-m px-6 md:w-fit w-full'
	%div.py-12
		%div{class: 'md:grid grid-cols-12 flex flex-col md:gap-6 gap-10'}
			.col-span-4.flex.flex-col{class: 'md:order-[1] order-[2]'}
				%div{class: 'logo logo-full h-6'}
					= show_svg 'logo.svg'
				.flex.items-center.gap-4.mb-6{class: 'md:mt-auto mt-6'}
					-# = link_to 'https://www.facebook.com/people/Gleam-News/61586371495666/', class: '', target: '_blank' do
					-# 	=	show_svg 'socials/facebook.svg'
					-# = link_to 'https://x.com/GleamNewsApp', class: '', target: '_blank' do
					-# 	=	show_svg 'socials/x.svg'
					-# = link_to 'https://www.instagram.com/gleam_news/', class: '', target: '_blank' do
					-# 	=	show_svg 'socials/instagram.svg'
				.text-secondary.mb-1 Tomes. Read the greatest books — for free.
				.text-secondary.opacity-60.text-sm © #{Time.current.year} Tomes. All rights reserved.
			%div{class: 'md:grid flex flex-col grid-cols-4 gap-6 col-span-8 md:order-[2]'}
				-	link_classes = 'text-secondary hover:text-black dark:hover:text-white w-fit '
				%div{class: 'md:block hidden'}
				.flex.flex-col.gap-2
					%h6.text-base.font-medium.mb-1 Explore
					-	Category.all.each do |cat|
						=	link_to cat.name, category_path(cat.slug), class: link_classes
				.flex.flex-col.gap-2
					%h6.text-base.font-medium.mb-1 Product
					= link_to 'About', about_path, class: link_classes
					-# = link_to 'Download app', download_app_path, class: link_classes
					-# = link_to 'Blog', root_path, class: link_classes
					= link_to 'Send feedback', 'mailto:hey@tomes.club', class: link_classes
					= link_to 'Community guidelines', community_guidelines_path, class: link_classes
				.flex.flex-col.gap-2
					%h6.text-base.font-medium.mb-1 Legal
					= link_to 'Privacy policy', privacy_path, class: link_classes
					= link_to 'Terms of service', terms_path, class: link_classes
				