- content_for(:has_back_to_btn, true)

.contain.contain--yield
	%div
		.flex.items-start{class: 'flex-col'}
			-	if @author_avatar.present?
				%img{src: @author_avatar, class: "md:min-w-25 md:w-25 min-w-20 w-20 mb-4 rounded-full apsect-square object-cover", alt: "#{@author.full_name}'s image"}
			- else
				%div{class: "md:min-w-25 md:w-25 min-w-20 w-20 mb-4 rounded-full aspect-square bg-surface flex-center"}
					%i.ph.ph-image.text-3xl
			.pt-2
				%h1.font-medium{class: 'md:text-[32px] text-3xl leading-none mb-4'}= @author.full_name
				-# %p.text-secondary
					%span= pluralize(@author.books_count, "book")
				%p.mt-2.text-secondary{class: 'md:max-w-1/2 md:line-clamp-2 line-clamp-3'}= @author.bio
				- if @author.wiki_url.present?
					%p.text-sm.text-secondary.mt-1 Read more on #{link_to 'Wikipedia', @author.wiki_url, target: '_blank', class: 'font-medium text-on-background'}.
		.flex.gap-2.mt-6
			-	if current_user&.admin?
				= link_to 'Edit page', edit_admins_author_path(@author.hashid), class: 'btn btn-border h-9'
			%button.btn.btn-surface.h-9{'data-share-trigger': '', 'data-share-url': author_url(@author.slug), 'data-share-title': @author.full_name, 'data-share-description': "Read #{@author.full_name}'s books on Tomes for free!"}
				%i.ph.ph-share-fat
				%span Share

	.mt-12
		%h3.text-xl.font-medium.flex.items-center.mb-3
			%span.font-medium.pr-2 Books
			%span.number-badge.text-sm= @author.books_count
		-	if @books.any?
			=	turbo_frame_tag "pagination", class: 'scroll-mt-[124px]' do
				.relative.w-full.grid.gap-4.gap-y-6{class: 'md:grid-cols-5 grid-cols-2'}
					= render partial: 'partials/book_card_block', collection: @books, as: :book, locals: {small: true}
				- if @pagy.pages > 1
					.mt-12.flex-center
						=raw	@pagy.series_nav
		- else
			= render 'partials/empty_state', title: "Nothing here", description: "We haven't added any books by #{@author.full_name} yet. Check back again soon."
		-# %div 
		-# 	%h3.text-lg.font-medium.mb-2 Biography
		-# 	%p.text-m.max-w-md.text-secondary= @author.bio
		-# 	%p.text-sm.text-secondary.mt-2 Read more on #{link_to 'Wikipedia', '', class: 'font-medium text-on-background'}.