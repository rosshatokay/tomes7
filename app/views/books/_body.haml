.w-full.flex.flex-col.gap-12.pb-16{class: 'md:pt-4 pt-6'}
	%section
		%h1.font-semibold.leading-none{class: 'md:text-[40px] md:mb-2 mb-3 text-3xl'}= @book.title
		%h2.leading-none{class: 'md:text-lg'}
			%div 
				- @book.authors.each_with_index do |author, i|
					%span #{link_to author.full_name, author_path(author.slug), class: 'hover:underline opacity-75'}#{i < @book.authors.size - 1 ? raw('<span>,</span>') : ''}

		.flex.items-center.gap-2{class: 'mt-2 -mx-2'}
			%a.flex.items-center{href: '#reviews', data: {turbo: false}, class: 'gap-1.5 btn-clear transition p-1 px-2 rounded-md'}
				= render 'partials/rating_stars', rating: @book.average_rating.to_i
				%span= @book.average_rating
				%span.text-secondary (#{@book.ratings_count} reviews)
			.border-l.border-outline.h-4{class: 'md:block hidden'}
			-	if user_signed_in?
				%button.save-btn{type: 'button', class: 'p-1 px-2 btn-clear cursor-pointer rounded-md transition md:flex items-center hidden gap-1.5', data: {controller: 'save-button', 'book-id': @book.hashid, 'is-liked': current_user&.likes?(@book) ? 'true' : 'false'}}
					%i.ph.ph-heart.text-lg.text-secondary.icon
					%span.label Save
			- else
				= link_to new_session_path(return_to: book_path(@book.slug)), type: 'button', class: 'p-1 px-2 btn-clear cursor-pointer rounded-md transition md:flex items-center hidden gap-1.5' do
					%i.ph.ph-heart.text-lg.text-secondary.icon
					%span.label Save
			.border-l.border-outline.h-4{class: 'md:block hidden'}
			%button{type: 'button', 'data-share-trigger': '', 'data-share-url': book_url(@book.slug), 'data-share-title': @book.title, 'data-share-description': "Read #{@book.title} on Tomes for free!", class: 'p-1 px-2 btn-clear cursor-pointer rounded-md transition md:flex items-center hidden gap-1.5'}
				%i.ph.ph-share-fat.text-lg.text-secondary
				%span Share
			- if current_user&.admin?
				.border-l.border-outline.h-4{class: 'md:block hidden'}
				=	link_to edit_admins_book_path(@book.hashid), class: 'p-1 px-2 btn-clear cursor-pointer rounded-md transition md:flex items-center hidden gap-1.5' do
					%i.ph.ph-pencil
					%span Edit
		.flex.flex-col.gap-4.mt-6
			= simple_format @book.description&.strip
		%p.text-secondary.text-sm.mt-2 Read more on #{link_to 'Wikipedia', @book.wiki_url, class: 'text-[var(--color-on-background)] font-medium hover:underline', target: '_blank'}.

		.flex.flex-wrap.mt-6{class: 'gap-2.5'}
			-	@book.tags.each do |tag|
				.bg-surface.text-secondary.text-sm.flex-center.h-7.px-3.rounded-md= tag.name.humanize

	-	unless @toc.nil?
		%section
			%h3.text-lg.font-medium.mb-4 Table of contents
			%div{ class: 'overflow-x-auto relative', data: {controller: 'toc'} }
				%div{ class: 'align-middle min-w-full' }
					%table{ class: 'min-w-full relative' }
						%thead
							%tr
								%th{class: "p-3 pt-0 font-normal text-secondary text-[15px] text-left pl-0 w-12"} #
								%th{class: "p-3 pt-0 font-normal text-secondary text-[15px] text-left"} Section
						%tbody
							-	@toc.take(5).each.with_index(1) do |c, i|
								%tr{class: 'border-t border-outline'}
									%td.p-3.pl-0{class: 'text-[15px]'}= i
									%td.p-3{class: 'text-[15px]'}= c['title']

			%button.btn.btn-clear.h-8.mx-auto.mt-2{class: '!text-link', 'data-micromodal-trigger': 'toc-modal'} Show more

	%section
		%h3.text-lg.font-medium.mb-4 About the #{@book.authors.size > 1 ? 'authors' : 'author'}
		.flex.flex-col.gap-6
			-	@book.authors.each do |author|
				%div
					= link_to author_path(author.slug), class: 'flex items-center gap-3 mb-3 group w-fit' do
						= ik_image_tag(author.avatar, transformation: [{width: 48, height: 48}], class: 'w-8 aspect-square rounded-full')
						%p.font-medium{class: 'group-hover:underline'}= author.full_name
					%p= author.bio
					-	if author.wiki_url.present?
						%p.text-secondary.text-sm.mt-2 Read more on #{link_to 'Wikipedia', author.wiki_url, class: 'text-[var(--color-on-background)] font-medium hover:underline', target: '_blank'}.


	%section
		%h3.text-lg.font-medium.mb-4 Readers also enjoyed
		.grid.gap-4{class: 'md:grid-cols-4 grid-cols-2 gap-y-6'}
			=	render partial: 'partials/book_card_block', collection: @book.similar_books.take(4), as: :book, locals: {small: true, hide_category: true, wrapper_class: 'flex'}
		
	= render 'ratings/reviews'
		

-	unless @toc.nil?
	= render 'partials/modal', id: 'toc-modal', title: 'Table of contents' do
		- @toc.each.with_index(1) do |c, i|
			.flex.items-start.gap-1.py-3{class: "#{i < @toc.size ? 'border-b border-outline' : ''}"}
				.w-9= i
				%p.font-medium= c['title']
