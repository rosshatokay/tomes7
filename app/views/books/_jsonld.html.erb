<%- content_for(:jsonld) do %>
<script type="application/ld+json">
<%= {
  "@context": "https://schema.org",
  "@type": "Book",
  "name": @book.title,
	"bookFormat": "https://schema.org/EBook",
  "image": @seo_image_url,
  "author": @book.authors.map { |a|
    {
      "@type": "Person",
      "name": a.full_name,
      "url": root_url
    }
  },
  "description": @book.description,
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": @book.average_rating,
    "ratingCount": @book.ratings_count,
    "reviewCount": @book.ratings_count
  }
}.to_json.html_safe %>
</script>
<% end %>