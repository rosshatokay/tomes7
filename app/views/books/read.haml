- content_for(:hide_bottom_nav, true)
- content_for(:hide_footer, true)
- content_for(:hide_nav, true)

.t-reader.flex.flex-col.h-screen.overflow-hidden{data: {slug: @book.slug, book_id: @book.hashid}}
	#top-nav.w-full.min-h-16.h-16.flex.items-center.px-6.grid.grid-cols-3.transition
		.flex.items-center.gap-4
			=	ik_image_tag(@book.cover, transformation: [{width: 100, height: 100}], class: 'min-w-10 w-10 aspect-square rounded-lg object-cover')
			%div 
				.text-sm.leading-none= @book.title
				.text-sm.text-secondary= @book.author_names
		.text-center
			.text-lg.headline.leading-none#chapter-label Chapter I.
		.flex.justify-end.gap-2.items-center
			#progress-indicator
			.btn.btn-icon.w-9.btn-clear#prev-page{'data-tippy-content': 'Previous page', 'data-tippy-icon': '◀'}
				%i.ph.ph-caret-left
			.btn.btn-icon.w-9.btn-clear#next-page{'data-tippy-content': 'Next page', 'data-tippy-icon': '▶'}
				%i.ph.ph-caret-right
			.action-menu#chapters
				.toggler
					.btn.btn-icon.w-9.btn-clear{'data-tippy-content': 'Chapters', 'data-tippy-icon': 'C'}
						%i.ph.ph-list
				.hidden
					.context{class: 'w-[300px]'}

	.h-full
		%div#spinner.flex-center.h-full.absolute.top-0.w-full
			%div{class: 'loading-spinner w-6 h-6 border-2'}
		%div{class: 'max-w-[1400px] md:py-2 md:px-5 px-2 h-full w-full mx-auto transition opacity-0', id: 'pages-area'}
		
	.footer.p-6.pt-0.text-center.min-h-10
		.text-secondary.text-sm#pages-left-label

= render 'partials/modal', title: "Navigating the Reader", id: 'navigation-modal' do
	%div.mb-4 Navigating the reader is quite easy. 
	%div.mb-4 
		%span In order to flip pages, you can either use your left/right arrow keys on your keyboard.
		%span Or use the 
		%span.inline-flex
			%i.ph.ph-caret-left.bg-surface.px-1{class: 'py-0.5 rounded-sm mx-0.5'}
			%i.ph.ph-caret-right.bg-surface.px-1{class: 'py-0.5 rounded-sm mx-0.5'}
		%span buttons in the top navigation bar.
	%div 
		%span To view the table of contents, click the 
		%span.inline-flex
			%i.ph.ph-list.bg-surface.px-1{class: 'py-0.5 rounded-sm mx-0.5'}
		%span button in the top navigation bar.
	%button.btn.btn-secondary.h-10.mx-auto.mt-6{'data-micromodal-close': ''} Understood


- content_for(:scripts) do
	%script(src="https://cdn.jsdelivr.net/npm/jszip@3.10.1/dist/jszip.min.js") 
	%script(src="https://cdn.jsdelivr.net/npm/epubjs@0.3.93/dist/epub.min.js") 
	= javascript_include_tag 'reader'