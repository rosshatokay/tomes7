- content_for(:has_back_to_btn, true)

=	render 'jsonld'
%div{data: {controller: 'book-page'}}
	%div{class: 'contain contain--yield flex flex-col md:flex-row'}
		= render 'cover_aside'
		=	render 'body'
		= render 'aside'

	= render 'review_modal'

%div{class: 'fixed bottom-4 left-1/2 -translate-x-1/2'}
	=	link_to read_book_path(@book.slug), data: {turbo: false}, class: 'btn gap-2 btn-primary h-12 text-m shadow-lg px-6' do
		%span Read the book
		%i.ph.ph-arrow-up-right{class: '!text-lg'}

- content_for(:back_to_actions) do
	.action-menu.is-sheet{'data-disable-scroll': 'on'}
		.toggler
			.btn.btn-icon.btn-clear.w-9
				%i.ph.ph-dots-three-outline.text-2xl
		.hidden
			.sheet
				.grid.grid-cols-3.p-3.py-4.gap-3
					=	link_to read_book_path(@book.slug), data: {turbo: false}, class: 'btn btn-surface w-full rounded-xl flex-col py-2' do
						%i.ph.ph-eyeglasses{class: '!text-3xl'}
						%span.text-secondary.font-normal Read
					-	if user_signed_in?
						.btn.btn-surface.w-full.rounded-xl.flex-col.save-btn{class: 'py-2', 'data-close-popup': 'true', data: {controller: 'save-button', 'book-id': @book.hashid, 'is-liked': current_user&.likes?(@book) ? 'true' : 'false'}}
							%i.ph.ph-heart.icon{class: '!text-3xl'}
							%span.text-secondary.font-normal.label Save
					- else
						=	link_to new_session_path, class: 'btn btn-surface w-full rounded-xl flex-col', 'data-close-popup': 'true' do
							%i.ph.ph-heart{class: '!text-3xl'}
							%span.text-secondary.font-normal Save
					%button.btn.btn-surface.w-full.rounded-xl.flex-col{type: 'button', class: 'py-2', 'data-share-trigger': '', 'data-share-url': book_url(@book.slug), 'data-share-title': @book.title, 'data-share-description': "Read #{@book.title} on Tomes for free!"}
						%i.ph.ph-share-fat{class: '!text-3xl'}
						%span.text-secondary.font-normal Share
				%hr.border-outline
				.flex.flex-col.gap-1.p-2
					.btn.btn-clear.h-11.rounded-xl.w-full.justify-start.gap-3.px-4
						%i.ph.ph-star{class: '!text-2xl'}
						%span.text-base.font-normal.truncate Rate this book
					- @book.authors.each do |author|
						.btn.btn-clear.h-11.rounded-xl.w-full.justify-start.gap-3.px-4
							%i.ph.ph-user{class: '!text-2xl'}
							%span.text-base.font-normal.truncate More from #{author.full_name}
					.btn.btn-clear.h-11.rounded-xl.w-full.justify-start.gap-3.px-4
						%i.ph.ph-arrow-up-right{class: '!text-2xl'}
						%span.text-base.font-normal.truncate Read Wikipedia page
					.btn.btn-clear.h-11.rounded-xl.w-full.justify-start.gap-3.px-4
						%i.ph.ph-at{class: '!text-2xl'}
						%span.text-base.font-normal.truncate Contact us
					.btn.btn-clear.h-11.rounded-xl.w-full.justify-start.gap-3.px-4
						%i.ph.ph-info{class: '!text-2xl'}
						%span.text-base.font-normal.truncate About Tomes